# ==============================================================================
# Multi-Tenant Subscription Platform - Environment Configuration (100% Free / Local)
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_DB=subscription_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/subscription_platform

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# Apache Kafka (KRaft Mode - 100% Free Local & Serverless Free Tier Compatible)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
KAFKA_UI_PORT=8085

# Mail Service (Local Mailpit - 100% Free)
# Open http://localhost:8025 to view all received emails
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@subscriptionplatform.local

# External Email Provider (Optional cloud showcase - Brevo/Resend Free Tier)
EMAIL_PROVIDER=mailpit
RESEND_API_KEY=
BREVO_API_KEY=

# Security & JWT
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Payment Gateway (Razorpay Sandbox / Test Mode - 100% Free mock checkout)
# Replace with your free test keys from https://dashboard.razorpay.com (Settings > API Keys)
RAZORPAY_KEY_ID=rzp_test_mockKeyId123456
RAZORPAY_KEY_SECRET=mockKeySecretValue789012
RAZORPAY_WEBHOOK_SECRET=mockWebhookSecret345678

# Server Ports
SERVER_PORT=8080
CLIENT_PORT=5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

