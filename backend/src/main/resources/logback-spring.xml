<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Include Spring Boot default color rules and properties -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml" />

    <!-- Structured Pattern with Correlation ID (traceId) and Tenant ID -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr(%5p) %clr([%15.15t]){faint} %clr([traceId=%X{correlationId:-N/A}]){yellow} %clr([tenantId=%X{tenantId:-N/A}]){green} %clr(%-40.40logger{39}){cyan} %clr(:){faint} %m%n%wEx" />

    <!-- Console Appender -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- Application Logger -->
    <logger name="com.subscription.platform" level="INFO" />

    <!-- Suppress verbose third-party loggers -->
    <logger name="org.apache.kafka" level="WARN" />
    <logger name="org.apache.catalina" level="INFO" />
    <logger name="org.springframework.web" level="INFO" />
    <logger name="org.hibernate" level="INFO" />
    <logger name="com.zaxxer.hikari" level="INFO" />

    <!-- Root Logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>

</configuration>
